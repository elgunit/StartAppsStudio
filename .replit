entrypoint = "README.md"
modules = ["nodejs-22", "postgresql-16", "python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000

[env]
PORT = "5000"

[agent]
stack = "nodejs"
integrations = ["javascript_database:1.0.0", "resend:1.0.0"]

[workflows]
runButton = "Start Backend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
